# Polar — sandbox first, then production
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_ID=
# sandbox | production
POLAR_SERVER=sandbox

# Public origin, no trailing slash
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Postgres
DATABASE_URL=postgres://user:pass@localhost:5432/copycat

# Outbound click tagging
NEXT_PUBLIC_UTM_SOURCE=copycat

# Vemetric analytics (client token — safe to expose). Leave blank to disable.
NEXT_PUBLIC_VEMETRIC_TOKEN=

# "see stats→" link target. Set to your Vemetric PUBLIC dashboard URL once enabled.
# Leave blank and the pill just scrolls to the board.
NEXT_PUBLIC_STATS_URL=
